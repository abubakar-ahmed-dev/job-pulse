# Dependency directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and credentials (CRITICAL: never commit real API keys)
.env
.env.local
.env.*.local

# Scraper cache (W5 requirement: never commit cached HTML pages)
cache/

# Runtime and quarantine logs (W7 requirement: local quarantine logs)
logs/
*.log

# Test coverage
coverage/
.nyc_output/

# OS-specific metadata
.DS_Store
Thumbs.db
ehthumbs.db

# IDE configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
