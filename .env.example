# ==============================================================================
# JobPulse Environment Configuration Template
# Copy this file to .env and customize values for local development.
# IMPORTANT: Never commit your real .env file with actual credentials to Git.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Provider Configuration
# OpenRouter (Hosted):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openrouter/free
#   LLM_API_KEY=your_openrouter_api_key_here
# Ollama (Local):
#   LLM_BASE_URL=http://localhost:11434/v1/
#   LLM_MODEL=llama3.2:3b
#   LLM_API_KEY=ollama
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=your_openrouter_api_key_here

# LLM Control Flags & Guardrails
# LLM_STUB=1 skips external model calls and returns deterministic valid schema objects
LLM_STUB=1

# LLM_ENABLED=false triggers the kill switch, returning deterministic fallback or 503
LLM_ENABLED=true

# Explicit LLM request timeout (in milliseconds, max 60s)
LLM_TIMEOUT_MS=30000

# Scraper Politeness Settings (W5 Requirements)
SCRAPER_USER_AGENT=JobPulse/1.0 (+https://github.com/abubakar-ahmed-dev/job-pulse; contact: abubakar.ahmed.dev@gmail.com)
SCRAPER_REQUEST_DELAY_MS=500
SCRAPER_TIMEOUT_MS=5000
